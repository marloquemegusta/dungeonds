# Git LFS: originales 3D y binarios pesados (política en AGENTS.md, «Ciclo de vida de los assets»).
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Texturas de los modelos (las de sprites y walkthroughs siguen en git normal)
assets/models/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/models/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/models/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/environment/cathedral/floor_tiles/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/environment/cathedral/floor_tiles/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/environment/cathedral/floor_tiles/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
