# Precompiled runtime binaries (fetched via scripts/setup.ps1)
runtime/bin/*.so
runtime/bin/desmume-agent
!runtime/bin/.gitkeep

# Large Docker tarballs (downloaded or loaded on demand)
images/*.tar
!images/.gitkeep

# Build and project artifacts
*.nds
artifacts/
.worktrees/
.ds-game-dev/build/
**/__pycache__/
*.pyc

# Local runtime source checkouts
runtime/source/
runtime/build/

# Local archives
*.tar.gz
*.zip

# Temporary scratch and staging
scratch/
temp_sprite_frames/
raw_sheet_b64.txt
test_frame.png
diag_frame.png

# Command Code local-only state
.commandcode/settings.json

# Local journals and session tracking
.codex-journal/

# Shader lab outputs and temporary runs
assets/lab_runs/

# Custom test assets
assets/characters/custom/

# 3D Source Environment Assets (Heavy external packs)
assets/environment/dreadhollow/GLB/
assets/environment/dreadhollow/Previews/
assets/characters/monster/Walking.fbx
graphify-out/

