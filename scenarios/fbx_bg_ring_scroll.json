      { "from": "west", "to": "west_release", "field": "input", "max_delta": -32 },
      { "from": "west_release", "to": "north", "field": "cam_y", "min_abs_delta": 1 },
      { "from": "west_release", "to": "north", "field": "input", "min_delta": 16 },
      { "from": "north", "to": "north_release", "field": "input", "max_delta": -16 }
    ]
  }
