{
  "name": "strip_climb_smoke",
  "description": "ROM cathedral-playground (sin horda; la variante por defecto tiene horda y bloquea la subida). God mode por el perfil de sandbox. Pasillo central: poke a (x 160, y 800). x 160 queda libre porque el relicario ocupa x 232..264 y su base impide llegar a y<768 en x 256. UP 60 frames cruza el primer rebase de 768 px (shift 768). Poke a (160, 800) otra vez y UP 60 frames: segundo rebase (shift 1536). Altura creciente.",
  "state": {
    "elf": "../.ds-game-dev/build/out/dungeonds-cathedral-playground.elf",
    "symbols": {
      "strip": "g_strip_debug",
      "sandbox": "g_sandbox"
    },
    "default_symbol": "strip",
    "fields": {
      "height_px": 0,
      "shift_px": 4,
      "alive": 8,
      "hp": 12,
      "seq": {
        "symbol": "sandbox",
        "offset": 0,
        "type": "u32"
      },
      "ack": {
        "symbol": "sandbox",
        "offset": 4,
        "type": "u32"
      },
      "player_x": {
        "symbol": "sandbox",
        "offset": 8,
        "type": "s16"
      },
      "player_y": {
        "symbol": "sandbox",
        "offset": 10,
        "type": "s16"
      },
      "enemy_count": {
        "symbol": "sandbox",
        "offset": 14,
        "type": "u8"
      }
    }
  },
  "steps": [
    {
      "frames": 30,
      "capture": "00_strip_start",
      "state_capture": "start"
    },
    {
      "poke": [
        {
          "field": "player_x",
          "value": 160
        },
        {
          "field": "player_y",
          "value": 800
        },
        {
          "field": "seq",
          "value": 100
        },
        {
          "field": "enemy_count",
          "value": 0
        }
      ],
      "frames": 20
    },
    {
      "button_down": "UP",
      "frames": 150,
      "capture": "01_tras_primer_rebase",
      "state_capture": "rebase1"
    },
    {
      "button_up": "UP",
      "frames": 2
    },
    {
      "poke": [
        {
          "field": "player_x",
          "value": 160
        },
        {
          "field": "player_y",
          "value": 800
        },
        {
          "field": "seq",
          "value": 101
        },
        {
          "field": "enemy_count",
          "value": 0
        }
      ],
      "frames": 20
    },
    {
      "button_down": "UP",
      "frames": 150,
      "capture": "02_tras_segundo_rebase",
      "state_capture": "climbed"
    },
    {
      "button_up": "UP",
      "frames": 2
    }
  ],
  "assertions": {
    "state_changes": [
      {
        "field": "shift_px",
        "at": "start",
        "equals": 0
      },
      {
        "field": "shift_px",
        "at": "rebase1",
        "min_value": 768
      },
      {
        "field": "shift_px",
        "at": "climbed",
        "min_value": 1536
      },
      {
        "field": "height_px",
        "from": "start",
        "to": "climbed",
        "min_delta": 1536
      }
    ],
    "screen_changes": [
      {
        "from": "00_strip_start",
        "to": "02_tras_segundo_rebase",
        "min_changed_pixels": 100
      }
    ]
  }
}
